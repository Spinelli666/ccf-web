generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  sheets       Sheet[]
  chatMessages ChatMessage[]
  mesasCriadas Mesa[]        @relation("MesasCriadas")
  mesaMembros  MesaMembro[]
}

model Mesa {
  id           String        @id @default(cuid())
  nome         String
  // Código curto (6 chars) que o Mestre compartilha com os jogadores pra entrar na mesa.
  codigo       String        @unique
  senhaHash    String
  ownerId      String
  owner        User          @relation("MesasCriadas", fields: [ownerId], references: [id])
  membros      MesaMembro[]
  sheets       Sheet[]
  chatMessages ChatMessage[]
  combate      Combate?
  createdAt    DateTime      @default(now())
}

model MesaMembro {
  id       String   @id @default(cuid())
  mesaId   String
  mesa     Mesa     @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([mesaId, userId])
}

model Sheet {
  id        String   @id @default(cuid())
  mesaId    String
  mesa      Mesa     @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  private   Boolean  @default(false)
  // Todo o restante da ficha (pericias, stats, armas, armaduras, remedios,
  // racaHabilidades, classeHabilidades, biografia...) igual ao formato que
  // o app original salvava em "sheet:<id>" no storage do artifact.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  combateParticipantes CombateParticipante[]

  @@index([ownerId])
  @@index([mesaId])
}

model Race {
  id          String   @id @default(cuid())
  nome        String   @unique
  habilidades Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum ChatMessageKind {
  roll
  text
  log
}

model ChatMessage {
  id             String           @id @default(cuid())
  mesaId         String
  mesa           Mesa             @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String
  characterName  String?
  kind           ChatMessageKind
  text           String
  breakdown      String?
  total          Int?
  critClass      String?
  createdAt      DateTime         @default(now())

  @@index([createdAt])
  @@index([mesaId])
}

// Uma mesa tem no máximo um combate ativo por vez — iniciar um novo substitui o anterior.
model Combate {
  id              String                @id @default(cuid())
  mesaId          String                @unique
  mesa            Mesa                  @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  rodada          Int                   @default(1)
  turnoAtualIndex Int                   @default(0)
  createdAt       DateTime              @default(now())
  participantes   CombateParticipante[]
}

model CombateParticipante {
  id            String   @id @default(cuid())
  combateId     String
  combate       Combate  @relation(fields: [combateId], references: [id], onDelete: Cascade)
  sheetId       String?
  sheet         Sheet?   @relation(fields: [sheetId], references: [id], onDelete: SetNull)
  nome          String
  iniciativa    Int?
  ordem         Int      @default(0)
  mostrarStatus Boolean  @default(false)

  @@index([combateId])
}
