generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  sheets       Sheet[]
  sheetFolders SheetFolder[]
  chatMessages ChatMessage[]
  mesasCriadas Mesa[]        @relation("MesasCriadas")
  mesaMembros  MesaMembro[]
}

model Mesa {
  id           String        @id @default(cuid())
  nome         String
  // Código curto (6 chars) que o Mestre compartilha com os jogadores pra entrar na mesa.
  codigo       String        @unique
  senhaHash    String
  ownerId      String
  owner        User          @relation("MesasCriadas", fields: [ownerId], references: [id])
  membros      MesaMembro[]
  sheets       Sheet[]
  sheetFolders SheetFolder[]
  chatMessages ChatMessage[]
  combate      Combate?
  createdAt    DateTime      @default(now())
}

model MesaMembro {
  id       String   @id @default(cuid())
  mesaId   String
  mesa     Mesa     @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([mesaId, userId])
}

model Sheet {
  id        String   @id @default(cuid())
  mesaId    String
  mesa      Mesa     @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  private   Boolean  @default(false)
  // Dono da ficha permite que outros jogadores da mesa (não só o Mestre) editem —
  // ex: um aliado precisa mexer no inventário. Mestre e dono sempre podem editar,
  // independente disso.
  editableByOthers Boolean @default(false)
  folderId  String?
  folder    SheetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Todo o restante da ficha (pericias, stats, armas, armaduras, remedios,
  // racaHabilidades, classeHabilidades, biografia...) igual ao formato que
  // o app original salvava em "sheet:<id>" no storage do artifact.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  combateParticipantes CombateParticipante[]
  cadernos             Caderno[]

  @@index([ownerId])
  @@index([mesaId])
  @@index([folderId])
}

// Pastas pra organizar as fichas de uma mesa (ex: separar NPCs de fichas de jogadores).
// Podem ser privadas (só o dono da pasta e o Mestre veem), igual às fichas.
model SheetFolder {
  id        String   @id @default(cuid())
  mesaId    String
  mesa      Mesa     @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  nome      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  private   Boolean  @default(false)
  sheets    Sheet[]
  createdAt DateTime @default(now())

  @@index([mesaId])
}

model Race {
  id          String   @id @default(cuid())
  nome        String   @unique
  habilidades Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum ChatMessageKind {
  roll
  text
  log
}

// Quem pode VER a mensagem (filtrado de verdade, tanto no socket quanto no histórico) —
// diferente de sheetPrivate, que é só um sinal visual (esmaece o card, mas todo mundo vê).
enum ChatMessageVisibility {
  public
  private
  gm
}

model ChatMessage {
  id             String           @id @default(cuid())
  mesaId         String
  mesa           Mesa             @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String
  characterName  String?
  // Ícone do personagem no momento da rolagem (data URL) — denormalizado, igual characterName,
  // pra não precisar joinar com Sheet (que pode nem existir mais) pra renderizar o chat.
  characterAvatarUrl String?
  kind           ChatMessageKind
  text           String
  breakdown      String?
  total          Int?
  critClass      String?
  sheetPrivate   Boolean          @default(false)
  visibility     ChatMessageVisibility @default(public)
  createdAt      DateTime         @default(now())

  @@index([createdAt])
  @@index([mesaId])
}

// Uma mesa tem no máximo um combate ativo por vez — iniciar um novo substitui o anterior.
model Combate {
  id              String                @id @default(cuid())
  mesaId          String                @unique
  mesa            Mesa                  @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  rodada          Int                   @default(1)
  turnoAtualIndex Int                   @default(0)
  createdAt       DateTime              @default(now())
  participantes   CombateParticipante[]
}

model CombateParticipante {
  id            String   @id @default(cuid())
  combateId     String
  combate       Combate  @relation(fields: [combateId], references: [id], onDelete: Cascade)
  sheetId       String?
  sheet         Sheet?   @relation(fields: [sheetId], references: [id], onDelete: SetNull)
  nome          String
  iniciativa    Int?
  ordem         Int      @default(0)
  mostrarStatus Boolean  @default(false)

  @@index([combateId])
}

// Cadernos de anotações de um personagem (ficha), com várias páginas em markdown.
// Só o dono da ficha edita; cada caderno escolhe se é privado (só o dono lê) ou
// público (quem pode ver a ficha também lê).
model Caderno {
  id        String          @id @default(cuid())
  sheetId   String
  sheet     Sheet           @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  titulo    String
  publico   Boolean         @default(false)
  ordem     Int             @default(0)
  paginas   CadernoPagina[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([sheetId])
}

model CadernoPagina {
  id        String   @id @default(cuid())
  cadernoId String
  caderno   Caderno  @relation(fields: [cadernoId], references: [id], onDelete: Cascade)
  titulo    String
  conteudo  String   @default("")
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cadernoId])
}
